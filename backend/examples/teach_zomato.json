    {"action": "OPEN_CART", "target": {"text": "View Cart", "clickable": true, "screen": "Restaurant"}},
    {"action": "SELECT_ADDRESS", "target": {"text": "Home", "contentDescription": "Deliver to Home", "clickable": true, "screen": "Cart"}},
    {"action": "CLICK", "target": {"text": "Proceed to Pay", "clickable": true, "screen": "Cart"}}
