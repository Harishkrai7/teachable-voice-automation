    {"action": "TYPE", "value": "D", "target": {"resourceId": "com.application.zomato:id/search_edit", "className": "android.widget.EditText", "screen": "Search"}},
    {"action": "TYPE", "value": "Domi", "target": {"resourceId": "com.application.zomato:id/search_edit", "className": "android.widget.EditText", "screen": "Search"}},
    {"action": "SEARCH", "value": "Dominos", "target": {"resourceId": "com.application.zomato:id/search_edit", "className": "android.widget.EditText", "screen": "Search"}},
    {"action": "SELECT", "target": {"text": "Domino's Pizza", "className": "android.widget.TextView", "clickable": true, "parentText": "Pizza, Fast Food", "screen": "Search"}},
    {"action": "CLICK", "target": {"text": "Offers", "clickable": true, "screen": "Restaurant"}},
    {"action": "BACK"},
