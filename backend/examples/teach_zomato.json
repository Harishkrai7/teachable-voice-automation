    {"action": "SELECT", "target": {"text": "Margherita", "className": "android.widget.TextView", "clickable": true, "screen": "Restaurant"}},
    {"action": "ADD_TO_CART", "target": {"resourceId": "com.application.zomato:id/add_button", "text": "ADD", "clickable": true, "screen": "Restaurant"}},
